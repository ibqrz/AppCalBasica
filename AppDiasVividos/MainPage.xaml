<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppDiasVividos.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15">
            <Label x:Name="lblNome" Text="Nome"/>
            <Entry x:Name="etrNome" BackgroundColor="LightGray" TextColor="Black"/>

            <Label x:Name="lblIdadeAtual" Text="Idade Atual"/>
            <Entry x:Name="etrIdadeAtual" BackgroundColor="LightGray" TextColor="Black"/>

            <Button x:Name="btnCalDiasVividos" Text="Calcular Dias Vividos"/>
            <Button x:Name="btnLimparCampos" Text="Limpar Campos"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
