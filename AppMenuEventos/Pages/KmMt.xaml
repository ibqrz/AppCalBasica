<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMenuEventos.KmMt"
             Title="KmMt">
    <VerticalStackLayout
        Spacing="20"
        Padding="20">
        <Label 
            Text="Covesor"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            Text="Kilometros > Metros"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            x:Name="lblKilometros"
            Text="Kilometros" />

        <Entry 
            x:Name="etrKilometros"/>

        <Button
            x:Name="btnCoverter"
            Text="Coverter"
            Clicked="btnCoverterOnClicked"/>

        <Label
            x:Name="lblMetros"
            Text="Metros"/>

        <Entry
            x:Name="etrMetros"
            HorizontalTextAlignment="Center"            
            IsEnabled="False"/>

        <Button
            x:Name="btnLimpar"
            Text="Limpar"
            Clicked="btnLimparOnClicked"/>
    
    </VerticalStackLayout>
</ContentPage>