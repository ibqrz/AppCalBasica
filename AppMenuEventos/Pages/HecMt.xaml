<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMenuEventos.HecMt"
             Title="HecMt">

    <ScrollView>
        <VerticalStackLayout
        Spacing="20"
        Padding="20">
            <Label 
                Text="Convesor"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Label 
                Text="Hectometro > Metros"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Label 
                x:Name="lblHectometros"
                Text="Hectometros" />

            <Entry 
                x:Name="etrHectometros"
                Keyboard="Numeric"/>

            <Button
                x:Name="btnConverter"
                Text="Converter"
                Clicked="btnConverterOnClicked"/>

            <Label
                x:Name="lblMetros"
                Text="Metros"/>

            <Entry
                x:Name="etrMetros"
                HorizontalTextAlignment="Center"
                TextColor="Black"
                IsEnabled="False"/>

            <Button
                x:Name="btnLimpar"
                Text="Limpar"
                Clicked="btnLimparOnClicked"/>
        
        </VerticalStackLayout>
    </ScrollView>    
</ContentPage>