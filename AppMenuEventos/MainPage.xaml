<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMenuEventos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="20">
            <Image
                Source="robot.png"
                HeightRequest="100"
                WidthRequest="100"/>

            <Label
                Text="APP - SISTEMA DE CONVERSÂO"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                FontSize="20"/>

            <Label
                Text="  O aplicativo de conversão de medidas contém um sistema desenvolvido em .NET MAUI usando o Visual Studio 2022 é uma ferramenta prática e eficiente para realizar conversões entre diferentes unidades de medida de comprimento. Ele oferece as seguintes funcionalidades:"
                FontSize="16"/>

            <Label
                Text="- Conversão de quilômetros (km) para metros (m);"
                FontSize="16"/>

            <Label
                Text="- Conversão de hectômetros (hm) para metros (m);"
                FontSize="16"/>

            <Label
                Text="- Conversão de metros (m) para centímetros (cm)."
                FontSize="16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
