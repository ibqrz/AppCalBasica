<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppMenuEventos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppMenuEventos"
    Shell.FlyoutBehavior="Flyout"
    Title="AppMenuEventos"
    Shell.TabBarIsVisible="False">

    <FlyoutItem
        Title="MENU"
        FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Kilometros > Metros"
            ContentTemplate="{DataTemplate local:KmMt}"
            Route="KmMt" />

        <ShellContent
            Title="Metros > Cetnímetros"
            ContentTemplate="{DataTemplate local:MtCm}"
            Route="MtCm" />

        <ShellContent
            Title="Hectometros > Metros"
            ContentTemplate="{DataTemplate local:HecMt}"
            Route="HecMt" />

        <ShellContent
            Title="Sobre"
            ContentTemplate="{DataTemplate local:Sobre}"
            Route="Sobre" />

    </FlyoutItem>

    

</Shell>
