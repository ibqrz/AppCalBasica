<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppCalcularMedias.MediaSimples"
             Title="MediaSimples">
    <VerticalStackLayout Spacing="20" Padding="20">
        <Label 
            Text="..:: CALCULAR MÉDIA SIMPLES::."
            FontAttributes="Bold"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label x:Name="lblNtotal1" 
               Text="Digite aqui sua primeira nota: "/>
        <Entry x:Name="etrNtotal1"/>

        <Label x:Name="lblNtotal2" 
               Text="Digite aqui sua segunda nota: "/>
        <Entry x:Name="etrNtotal2"/>

        <Button x:Name="btnCacular"
            Text="Calcular Média"/>

    </VerticalStackLayout>
</ContentPage>